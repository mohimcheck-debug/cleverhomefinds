---
import Base from '../../layouts/Base.astro';
import ProductCard from '../../components/ProductCard.astro';
import EmailSignup from '../../components/EmailSignup.astro';
import { getCollection, render } from 'astro:content';
import { categories, amazonLink, disclosure } from '../../data/site.js';

export async function getStaticPaths() {
  const products = await getCollection('products');
  return products.map((p) => ({ params: { slug: p.id }, props: { product: p } }));
}
const { product } = Astro.props;
const d = product.data;
const { Content } = await render(product);
const cat = categories.find((c) => c.id === d.category);
const all = await getCollection('products');
const related = [...all.filter((p) => p.data.category === d.category && p.id !== product.id), ...all.filter((p) => p.data.category !== d.category)].slice(0, 4);
const buy = amazonLink(d);
const img = d.imageUrl || d.image;
---
<Base title={d.title} description={d.summary}>
  <article class="section product-page">
    <div class="wrap">
      <p class="crumbs"><a href="/shop/">Shop</a> <span aria-hidden="true">/</span> <a href={`/category/${d.category}/`}>{cat?.name}</a></p>
      <div class="product">
        <div class="media">
          {d.youtubeId ? (
            <div class="video">
              <iframe src={`https://www.youtube-nocookie.com/embed/${d.youtubeId}`} title={`Video: ${d.title}`} loading="lazy" allow="accelerometer; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
            </div>
          ) : (
            <div class="photo studio" data-cat={d.category}>
              {img && <img src={img} alt={d.title} width="800" height="800" />}
            </div>
          )}
        </div>
        <div class="info">
          <p class="cat-name">{cat?.name}</p>
          <h1>{d.title}</h1>
          <p class="summary">{d.summary}</p>
          <div class="buy">
            <a class="btn btn-buy btn-big" href={buy} target="_blank" rel="nofollow sponsored noopener">Check price on Amazon</a>
            <span class="band">{d.priceBand} when we posted it</span>
          </div>
          <h2 class="h-small">Why it made the cut</h2>
          <ul class="why">{d.bullets.map((b) => <li>{b}</li>)}</ul>
          {(d.bestFor || d.headsUp) && (
            <div class="notes">
              {d.bestFor && <div class="note"><strong>Best for</strong><p>{d.bestFor}</p></div>}
              {d.headsUp && <div class="note note-warn"><strong>Heads up</strong><p>{d.headsUp}</p></div>}
            </div>
          )}
          {d.specs.length > 0 && (
            <>
              <h2 class="h-small">Quick specs</h2>
              <ul class="specs">{d.specs.map((s) => <li>{s}</li>)}</ul>
            </>
          )}
          <p class="disclosure">{disclosure}</p>
        </div>
      </div>
      <div class="story">
        <h2>The short version</h2>
        <div class="prose"><Content /></div>
        <a class="btn btn-buy" href={buy} target="_blank" rel="nofollow sponsored noopener">See it on Amazon</a>
      </div>
    </div>
  </article>

  <section class="section section-tint">
    <div class="wrap">
      <h2>You might also like</h2>
      <div class="grid">{related.map((p) => <ProductCard product={p} />)}</div>
    </div>
  </section>
  <EmailSignup />
</Base>

<style>
  .product-page { padding-top: 2rem; }
  .crumbs { font-size: .9rem; color: var(--muted); }
  .crumbs a { color: var(--muted); }
  .product { display: grid; gap: clamp(1.5rem, 4vw, 4rem); grid-template-columns: 1.1fr 1fr; align-items: start; margin-top: 1rem; }
  @media (max-width: 860px) { .product { grid-template-columns: 1fr; } }
  .media { position: sticky; top: 6rem; }
  @media (max-width: 860px) { .media { position: static; } }
  .photo { aspect-ratio: 1; border-radius: var(--radius); display: grid; place-items: center; }
  .photo img { width: 82%; height: 82%; object-fit: contain; }
  .video { aspect-ratio: 9 / 16; max-height: 80vh; margin-inline: auto; border-radius: var(--radius); overflow: hidden; background: #000; }
  .video iframe { width: 100%; height: 100%; border: 0; }
  .cat-name { color: var(--green); font-weight: 600; margin-bottom: .4rem; }
  .info h1 { font-size: clamp(2rem, 4vw, 3rem); }
  .summary { font-size: 1.2rem; color: var(--muted); }
  .buy { display: flex; flex-wrap: wrap; align-items: center; gap: .75rem 1rem; margin: 1.5rem 0 2rem; }
  .btn-big { font-size: 1.1rem; padding: 1rem 1.9rem; }
  .band { font-size: .9rem; color: var(--muted); }
  .h-small { font-size: 1.2rem; margin: 1.75rem 0 .75rem; }
  .why { padding: 0; list-style: none; margin: 0; }
  .why li { padding: .7rem 0 .7rem 2rem; border-top: 1px solid var(--line); position: relative; }
  .why li:last-child { border-bottom: 1px solid var(--line); }
  .why li::before { content: ''; position: absolute; left: .25rem; top: 1.05rem; width: .9rem; height: .5rem; border-left: 2.5px solid var(--green); border-bottom: 2.5px solid var(--green); transform: rotate(-45deg); }
  .notes { display: grid; gap: .75rem; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); margin-top: 1.5rem; }
  .note { background: #eef4f0; border-radius: 14px; padding: 1rem 1.1rem; }
  .note-warn { background: #fbf3e2; }
  .note strong { display: block; margin-bottom: .2rem; }
  .note p { margin: 0; font-size: .95rem; color: #3c4a47; }
  .specs { padding-left: 1.1rem; margin: 0; color: #3c4a47; }
  .specs li { margin-bottom: .3rem; }
  .disclosure { font-size: .82rem; color: var(--muted); margin-top: 1.75rem; }
  .story { margin-top: clamp(2.5rem, 6vw, 4rem); max-width: 70ch; }
  .story .prose { font-size: 1.1rem; }
</style>
